{
    "info": {
        "name": "Ash Scrap Worker - Tests Production",
        "description": "Tests pour vérifier le fonctionnement des APIs Apollo et Kaspr dans le worker Cloudflare",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Test Extraction Complète",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"extraction_id\": \"test-{{$timestamp}}\",\n  \"country\": \"France\",\n  \"company_type\": \"restaurant\",\n  \"keywords\": [\"pizza\", \"italien\"],\n  \"file_format\": \"csv\"\n}"
                },
                "url": {
                    "raw": "https://enseigne-collector.martindetours98.workers.dev/extract",
                    "protocol": "https",
                    "host": [
                        "enseigne-collector",
                        "martindetours98",
                        "workers",
                        "dev"
                    ],
                    "path": [
                        "extract"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response has extraction_id', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('extraction_id');",
                            "    pm.globals.set('extraction_id', jsonData.extraction_id);",
                            "});",
                            "",
                            "pm.test('Workflow started', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData.success).to.be.true;",
                            "    pm.expect(jsonData.status).to.eql('collecting_places');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "2. Vérifier Statut Extraction",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "https://enseigne-collector.martindetours98.workers.dev/status?extraction_id={{extraction_id}}",
                    "protocol": "https",
                    "host": [
                        "enseigne-collector",
                        "martindetours98",
                        "workers",
                        "dev"
                    ],
                    "path": [
                        "status"
                    ],
                    "query": [
                        {
                            "key": "extraction_id",
                            "value": "{{extraction_id}}"
                        }
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Has status and progress', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('status');",
                            "    pm.expect(jsonData).to.have.property('progress_percentage');",
                            "});",
                            "",
                            "console.log('Status:', pm.response.json().status);",
                            "console.log('Progress:', pm.response.json().progress_percentage + '%');"
                        ]
                    }
                }
            ]
        },
        {
            "name": "3. Continuer Workflow (si bloqué)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"extraction_id\": \"{{extraction_id}}\"\n}"
                },
                "url": {
                    "raw": "https://enseigne-collector.martindetours98.workers.dev/continue",
                    "protocol": "https",
                    "host": [
                        "enseigne-collector",
                        "martindetours98",
                        "workers",
                        "dev"
                    ],
                    "path": [
                        "continue"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Step executed', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData.success).to.be.true;",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "4. Test Forcer Completion (avec données test)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"extraction_id\": \"{{extraction_id}}\"\n}"
                },
                "url": {
                    "raw": "https://enseigne-collector.martindetours98.workers.dev/force-continue",
                    "protocol": "https",
                    "host": [
                        "enseigne-collector",
                        "martindetours98",
                        "workers",
                        "dev"
                    ],
                    "path": [
                        "force-continue"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Workflow completed with test data', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData.success).to.be.true;",
                            "    pm.expect(jsonData).to.have.property('places_added');",
                            "    console.log('Places added:', jsonData.places_added);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "5. Test Simple Apollo (via extraction)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"extraction_id\": \"apollo-test-{{$timestamp}}\",\n  \"country\": \"France\",\n  \"company_type\": \"tech startup\",\n  \"keywords\": [\"software\"],\n  \"file_format\": \"json\"\n}"
                },
                "url": {
                    "raw": "https://enseigne-collector.martindetours98.workers.dev/extract",
                    "protocol": "https",
                    "host": [
                        "enseigne-collector",
                        "martindetours98",
                        "workers",
                        "dev"
                    ],
                    "path": [
                        "extract"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Apollo API accessible', function () {",
                            "    pm.response.to.have.status(200);",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData.success).to.be.true;",
                            "});",
                            "",
                            "// Sauvegarder l'ID pour le suivi",
                            "const jsonData = pm.response.json();",
                            "pm.globals.set('apollo_extraction_id', jsonData.extraction_id);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "6. Test Simple Kaspr (via extraction)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"extraction_id\": \"kaspr-test-{{$timestamp}}\",\n  \"country\": \"France\",\n  \"company_type\": \"marketing agency\",\n  \"keywords\": [\"digital\"],\n  \"file_format\": \"csv\"\n}"
                },
                "url": {
                    "raw": "https://enseigne-collector.martindetours98.workers.dev/extract",
                    "protocol": "https",
                    "host": [
                        "enseigne-collector",
                        "martindetours98",
                        "workers",
                        "dev"
                    ],
                    "path": [
                        "extract"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Kaspr API accessible', function () {",
                            "    pm.response.to.have.status(200);",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData.success).to.be.true;",
                            "});",
                            "",
                            "// Sauvegarder l'ID pour le suivi",
                            "const jsonData = pm.response.json();",
                            "pm.globals.set('kaspr_extraction_id', jsonData.extraction_id);"
                        ]
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "https://enseigne-collector.martindetours98.workers.dev"
        }
    ]
}